{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "SolversHub — Design Tokens (DTCG). Fuente única de verdad de la identidad visual. Genera CSS (panel/landing), tema React Native (app) y recursos Android. Editar SOLO este archivo y correr `node build.mjs`.",
  "brand": {
    "$description": "Metadatos de marca (no generan variables CSS).",
    "product": { "$value": "SolversHub" },
    "company": { "$value": "Roshi" },
    "tagline": { "$value": "Centro de soluciones impulsado con IA" },
    "version": { "$value": "1.4" }
  },
  "color": {
    "$type": "color",
    "$description": "Primitivos de color. El hex vive SOLO aquí.",
    "navy": {
      "950": { "$value": "#080F22" },
      "900": { "$value": "#0B1733" },
      "800": { "$value": "#11224D" },
      "750": { "$value": "#16294F", "$description": "surface-2 en oscuro (entre 800 y 700)" },
      "700": { "$value": "#172F6C", "$description": "PRIMARIO de marca" },
      "600": { "$value": "#21408A" }
    },
    "blue": {
      "500": { "$value": "#2F6BFF", "$description": "interacción / enlaces (oscuro)" },
      "600": { "$value": "#2560E6", "$description": "enlaces en claro (AA sobre blanco/paper)" }
    },
    "cyan": { "400": { "$value": "#22C7E0", "$description": "acento IA / foco / datos" } },
    "gold": { "500": { "$value": "#C9A227", "$description": "acento premium (uso medido)" } },
    "slate": {
      "600": { "$value": "#5A6B85", "$description": "texto secundario sobre claro" },
      "500": { "$value": "#616F88", "$description": "texto terciario sobre claro (AA 4.81)" },
      "400": { "$value": "#7C8AA3", "$description": "borde de controles en claro (3.49 sobre blanco)" },
      "300": { "$value": "#C9D2E3", "$description": "texto secundario sobre oscuro / borde fuerte claro" }
    },
    "ice": { "$value": "#E8EDF7", "$description": "texto principal en oscuro (sin blanco puro)" },
    "fog": { "$value": "#A9B6CC", "$description": "texto secundario en oscuro (AAA)" },
    "haze": { "$value": "#8695B0", "$description": "texto terciario en oscuro (AA 5.1)" },
    "steel": { "$value": "#6B7A94", "$description": "borde de controles en oscuro (3.56 sobre surface)" },
    "cloud": { "$value": "#EEF2F8", "$description": "bg-deep en claro" },
    "frost": { "$value": "#F1F5FA", "$description": "surface-2/hover en claro" },
    "veil": { "$value": "#EDF1F7", "$description": "borde suave en claro" },
    "white": { "$value": "#FFFFFF" },
    "paper": { "$value": "#F7F9FC", "$description": "fondo claro principal" },
    "mist": { "$value": "#E2E8F2", "$description": "bordes y divisores en claro" },
    "success": { "$value": "#22A06B" },
    "warning": { "$value": "#E0A106" },
    "danger": { "$value": "#D64545" },
    "status": {
      "$description": "Texto e íconos de estado con contraste AA por tema (SPEC-29, HU-DS-01). Los base (success/warning/danger) quedan para rellenos y marcas no textuales.",
      "light": {
        "success": { "$value": "#17784F", "$description": "5,47:1 sobre blanco" },
        "warning": { "$value": "#8A6100", "$description": "5,54:1 sobre blanco" },
        "danger": { "$value": "#B42E2E", "$description": "6,23:1 sobre blanco" },
        "info": { "$value": "#2058D6", "$description": "6,13:1 sobre blanco; 4,92:1 sobre su tinte en paper (blue-600 daba 4,33)" }
      },
      "dark": {
        "success": { "$value": "#2FBF7F", "$description": "6,53:1 sobre navy-800" },
        "danger": { "$value": "#F28B82", "$description": "6,46:1 sobre navy-800" }
      }
    },
    "data": {
      "$description": "Paleta de datos validada con dataviz/validate_palette.js (categórica: banda de L, croma, CVD ≥ 10,7, visión normal ≥ 19,4, contraste ≥ 3:1; rampas ordinales monotónicas). Orden fijo, nunca se cicla.",
      "light": {
        "1": { "$value": "#2560E6", "$description": "azul" },
        "2": { "$value": "#B8860B", "$description": "oro" },
        "3": { "$value": "#0E9DB5", "$description": "cyan (también serie única)" },
        "4": { "$value": "#7B4FD6", "$description": "violeta" },
        "seq-1": { "$value": "#52C2D5" },
        "seq-2": { "$value": "#2AA9BF" },
        "seq-3": { "$value": "#13929F" },
        "seq-4": { "$value": "#0E7585" },
        "seq-5": { "$value": "#0A5866" }
      },
      "dark": {
        "1": { "$value": "#4F7FF5", "$description": "azul" },
        "2": { "$value": "#A8851A", "$description": "oro" },
        "3": { "$value": "#139AAF", "$description": "cyan" },
        "4": { "$value": "#8E6CE8", "$description": "violeta" },
        "seq-1": { "$value": "#13798A" },
        "seq-2": { "$value": "#1A9BB0" },
        "seq-3": { "$value": "#3DBCD0" },
        "seq-4": { "$value": "#73D3E2" },
        "seq-5": { "$value": "#AEE7F0" }
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": { "$value": "linear-gradient(135deg, #2F6BFF 0%, #22C7E0 100%)", "$description": "Solo en acentos sin texto (logo, subrayado de 2 px, íconos). Con texto blanco da 2,04:1 en el extremo cyan: para botones usar gradient.cta." },
    "cta": { "$value": "linear-gradient(135deg, {color.navy.700} 0%, {color.blue.600} 100%)", "$description": "CTA principal con texto blanco (≥ 5,39:1 en todo el recorrido). El gradiente brand queda para acentos sin texto." }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": "Montserrat, 'Century Gothic', 'Didact Gothic', system-ui, sans-serif", "$description": "Display / titulares / cifras grandes. (manual §6)" },
    "body": { "$value": "Inter, 'Segoe UI', system-ui, sans-serif", "$description": "Cuerpo, UI y formularios." },
    "mono": { "$value": "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace", "$description": "Código, tokens, IDs, métricas técnicas." }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "20px" },
    "pill": { "$value": "9999px" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Escala base 4.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "theme": {
    "$description": "Capa semántica: mapea primitivos a roles de UI. Contraste WCAG verificado (AA mínimo, AAA en cuerpo). Oscuro por defecto (manual §5.5/§10); claro aprobado v1.4. v1.4 (SPEC-29): estados por tema, datos y elevación. En oscuro la elevación se marca con el paso de superficie y el borde; la sombra solo separa popovers y diálogos.",
    "dark": {
      "bg": { "$value": "{color.navy.900}" },
      "bg-deep": { "$value": "{color.navy.950}" },
      "surface": { "$value": "{color.navy.800}" },
      "surface-2": { "$value": "{color.navy.750}" },
      "surface-raised": { "$value": "{color.navy.700}" },
      "border": { "$value": "rgba(201, 210, 227, 0.10)" },
      "border-soft": { "$value": "rgba(201, 210, 227, 0.06)" },
      "border-strong": { "$value": "{color.navy.600}" },
      "control-border": { "$value": "{color.steel}" },
      "text": { "$value": "{color.ice}" },
      "text-strong": { "$value": "{color.white}" },
      "text-muted": { "$value": "{color.fog}" },
      "text-soft": { "$value": "{color.haze}" },
      "link": { "$value": "{color.cyan.400}" },
      "focus": { "$value": "{color.cyan.400}" },
      "hover": { "$value": "rgba(201, 210, 227, 0.06)" },
      "overlay": { "$value": "rgba(8, 15, 34, 0.72)" },
      "status-success-fg": { "$value": "{color.status.dark.success}" },
      "status-success-bg": { "$value": "rgba(34, 160, 107, 0.12)" },
      "status-success-border": { "$value": "rgba(34, 160, 107, 0.32)" },
      "status-warning-fg": { "$value": "{color.warning}" },
      "status-warning-bg": { "$value": "rgba(224, 161, 6, 0.12)" },
      "status-warning-border": { "$value": "rgba(224, 161, 6, 0.32)" },
      "status-danger-fg": { "$value": "{color.status.dark.danger}" },
      "status-danger-bg": { "$value": "rgba(214, 69, 69, 0.12)" },
      "status-danger-border": { "$value": "rgba(214, 69, 69, 0.32)" },
      "status-info-fg": { "$value": "{color.cyan.400}" },
      "status-info-bg": { "$value": "rgba(34, 199, 224, 0.12)" },
      "status-info-border": { "$value": "rgba(34, 199, 224, 0.32)" },
      "data-cat-1": { "$value": "{color.data.dark.1}" },
      "data-cat-2": { "$value": "{color.data.dark.2}" },
      "data-cat-3": { "$value": "{color.data.dark.3}" },
      "data-cat-4": { "$value": "{color.data.dark.4}" },
      "data-single": { "$value": "{color.cyan.400}" },
      "data-seq-1": { "$value": "{color.data.dark.seq-1}" },
      "data-seq-2": { "$value": "{color.data.dark.seq-2}" },
      "data-seq-3": { "$value": "{color.data.dark.seq-3}" },
      "data-seq-4": { "$value": "{color.data.dark.seq-4}" },
      "data-seq-5": { "$value": "{color.data.dark.seq-5}" },
      "data-grid": { "$value": "rgba(201, 210, 227, 0.10)" },
      "data-axis": { "$value": "{color.haze}" },
      "elev-0": { "$type": "shadow", "$value": "none" },
      "elev-1": { "$type": "shadow", "$value": "none" },
      "elev-2": { "$type": "shadow", "$value": "0 8px 24px rgba(0, 0, 0, 0.32)" },
      "elev-3": { "$type": "shadow", "$value": "0 16px 48px rgba(0, 0, 0, 0.40)" }
    },
    "light": {
      "bg": { "$value": "{color.paper}" },
      "bg-deep": { "$value": "{color.cloud}" },
      "surface": { "$value": "{color.white}" },
      "surface-2": { "$value": "{color.frost}" },
      "surface-raised": { "$value": "{color.frost}" },
      "border": { "$value": "{color.mist}" },
      "border-soft": { "$value": "{color.veil}" },
      "border-strong": { "$value": "{color.slate.300}" },
      "control-border": { "$value": "{color.slate.400}" },
      "text": { "$value": "{color.navy.900}" },
      "text-strong": { "$value": "{color.navy.950}" },
      "text-muted": { "$value": "{color.slate.600}" },
      "text-soft": { "$value": "{color.slate.500}" },
      "link": { "$value": "{color.blue.600}" },
      "focus": { "$value": "{color.blue.600}" },
      "hover": { "$value": "{color.frost}" },
      "overlay": { "$value": "rgba(11, 23, 51, 0.48)" },
      "status-success-fg": { "$value": "{color.status.light.success}" },
      "status-success-bg": { "$value": "rgba(34, 160, 107, 0.12)" },
      "status-success-border": { "$value": "rgba(34, 160, 107, 0.32)" },
      "status-warning-fg": { "$value": "{color.status.light.warning}" },
      "status-warning-bg": { "$value": "rgba(224, 161, 6, 0.12)" },
      "status-warning-border": { "$value": "rgba(224, 161, 6, 0.32)" },
      "status-danger-fg": { "$value": "{color.status.light.danger}" },
      "status-danger-bg": { "$value": "rgba(214, 69, 69, 0.12)" },
      "status-danger-border": { "$value": "rgba(214, 69, 69, 0.32)" },
      "status-info-fg": { "$value": "{color.status.light.info}" },
      "status-info-bg": { "$value": "rgba(37, 96, 230, 0.12)" },
      "status-info-border": { "$value": "rgba(37, 96, 230, 0.32)" },
      "data-cat-1": { "$value": "{color.data.light.1}" },
      "data-cat-2": { "$value": "{color.data.light.2}" },
      "data-cat-3": { "$value": "{color.data.light.3}" },
      "data-cat-4": { "$value": "{color.data.light.4}" },
      "data-single": { "$value": "{color.data.light.3}" },
      "data-seq-1": { "$value": "{color.data.light.seq-1}" },
      "data-seq-2": { "$value": "{color.data.light.seq-2}" },
      "data-seq-3": { "$value": "{color.data.light.seq-3}" },
      "data-seq-4": { "$value": "{color.data.light.seq-4}" },
      "data-seq-5": { "$value": "{color.data.light.seq-5}" },
      "data-grid": { "$value": "{color.mist}" },
      "data-axis": { "$value": "{color.slate.500}" },
      "elev-0": { "$type": "shadow", "$value": "none" },
      "elev-1": { "$type": "shadow", "$value": "0 1px 2px rgba(8, 15, 34, 0.06)" },
      "elev-2": { "$type": "shadow", "$value": "0 8px 24px rgba(8, 15, 34, 0.12)" },
      "elev-3": { "$type": "shadow", "$value": "0 16px 48px rgba(8, 15, 34, 0.18)" }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Escala tipográfica (SPEC-29 design §1). `web` va a tokens.css; `app` va al tema React Native. Cifras comparables con tabular-nums.",
    "web": {
      "hero": { "$value": { "fontFamily": "{font.display}", "fontSize": "30px", "lineHeight": "36px", "fontWeight": 700 } },
      "h1": { "$value": { "fontFamily": "{font.display}", "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600 } },
      "block": { "$value": { "fontFamily": "{font.display}", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 } },
      "body": { "$value": { "fontFamily": "{font.body}", "fontSize": "15px", "lineHeight": "24px", "fontWeight": 400 } },
      "dense": { "$value": { "fontFamily": "{font.body}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 } },
      "label": { "$value": { "fontFamily": "{font.body}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 500 } },
      "caption": { "$value": { "fontFamily": "{font.body}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400 } },
      "mono": { "$value": { "fontFamily": "{font.mono}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } }
    },
    "app": {
      "hero": { "$value": { "fontFamily": "{font.display}", "fontSize": "28px", "lineHeight": "34px", "fontWeight": 700 } },
      "h1": { "$value": { "fontFamily": "{font.display}", "fontSize": "22px", "lineHeight": "28px", "fontWeight": 600 } },
      "block": { "$value": { "fontFamily": "{font.display}", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 } },
      "body": { "$value": { "fontFamily": "{font.body}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 } },
      "dense": { "$value": { "fontFamily": "{font.body}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 } },
      "label": { "$value": { "fontFamily": "{font.body}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500 } },
      "caption": { "$value": { "fontFamily": "{font.body}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400 } },
      "mono": { "$value": { "fontFamily": "{font.mono}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } }
    }
  },
  "motion": {
    "$description": "Duraciones y curvas (SPEC-29 design §7). La salida dura ~75 % de la entrada. Con reducir movimiento, todo a 0.",
    "duration": {
      "$type": "duration",
      "instant": { "$value": "100ms", "$description": "presión" },
      "fast": { "$value": "150ms", "$description": "hover, foco, dropdown" },
      "base": { "$value": "200ms", "$description": "diálogo, toast" },
      "slow": { "$value": "250ms", "$description": "sheet, cajón" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0, 0, 1], "$description": "entradas y la mayoría de transiciones" },
      "in": { "$value": [0.3, 0, 1, 1], "$description": "salidas" },
      "emphasized": { "$value": [0.05, 0.7, 0.1, 1], "$description": "sheet y cajón" }
    }
  },
  "density": {
    "$type": "dimension",
    "$description": "Alturas de filas y controles. La app usa siempre control-lg (48 dp).",
    "row-comfortable": { "$value": "48px" },
    "row-compact": { "$value": "40px" },
    "control-md": { "$value": "40px" },
    "control-lg": { "$value": "48px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Contrato del shell del panel (iguales a Tailwind). Informativos: las media queries no leen variables CSS.",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
